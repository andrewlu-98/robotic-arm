<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="gray">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1" />
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1" />
    </material>

    <material name="black">
        <color rgba="0 0 0 1" />
    </material>

    <link name="world"/>

    <joint name="base_joint" type="fixed">
        <parent link="world"/>
        <child link="base"/>
        <origin xyz="0 0 0"/>
    </joint>

    <link name="base">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.2 0.2 0.2"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.2 0.2 0.2"/>
            </geometry>
        </collision>
    </link>

    <joint name="axis1_joint" type="revolute">
        <parent link="base"/>
        <child link="axis1"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.15" upper="3.15" effort="100" velocity="1.0"/>
    </joint>

    <link name="axis1">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.1" length="0.2"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="axis2_joint" type="revolute">
        <parent link="axis1"/>
        <child link="axis2"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
    </joint>

    <link name="axis2">
        <visual>
            <origin xyz="0 0 0.45"/>
            <geometry>
                <cylinder radius="0.05" length="0.9"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.45"/>
            <geometry>
                <cylinder radius="0.05" length="0.9"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="axis3_joint" type="revolute">
        <parent link="axis2"/>
        <child link="axis3"/>
        <origin xyz="0 0 0.9"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3" upper="3" effort="100" velocity="1.0"/>
    </joint>

    <link name="axis3">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="axis4_joint" type="revolute">
        <parent link="axis3"/>
        <child link="axis4"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.15" upper="3.15" effort="100" velocity="1.0"/>
    </joint>

    <link name="axis4">
        <visual>
            <origin xyz="0 0 0.5"/>
            <geometry>
                <cylinder radius="0.05" length="1"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.5"/>
            <geometry>
                <cylinder radius="0.05" length="1"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>